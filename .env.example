DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=Vezapp
JWT_SECRET=
SESSION_COOKIE_NAME=qclink_session
SESSION_TTL_DAYS=60

# App URL (for absolute links in emails)
APP_URL=http://localhost:3000

# S3 Storage (optional in local dev — falls back to local disk in public/uploads/ if unset)
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=

# Email (optional in local dev — falls back to console logging if unset)
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_ADDRESS=

# Google Sheets sync (optional — data mirrors to this sheet on every save when set)
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_CLIENT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY=
